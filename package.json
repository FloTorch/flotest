{
  "name": "@flotorch/flotest",
  "version": "0.4.0",
  "description": "LLM inference load testing and benchmarking tool",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flotorch/flotest"
  },
  "bin": {
    "flotest": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --type-aware",
    "format": "oxfmt",
    "build": "tsup",
    "dev": "tsx index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "rm -rf dist && tsup"
  },
  "dependencies": {
    "@smithy/hash-node": "4.2.11",
    "@smithy/protocol-http": "5.3.11",
    "@smithy/signature-v4": "5.3.11",
    "gpt-tokenizer": "3.4.0",
    "ink": "6.8.0",
    "react": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.3.5",
    "@types/react": "19.2.14",
    "oxfmt": "0.36.0",
    "oxlint": "1.51.0",
    "oxlint-tsgolint": "0.16.0",
    "tsup": "8.5.1",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  }
}
