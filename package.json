{
  "name": "@flotorch/flotest",
  "version": "0.4.0",
  "description": "LLM inference load testing and benchmarking tool",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flotorch/flotest"
  },
  "bin": {
    "flotest": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --type-aware",
    "format": "oxfmt",
    "build": "tsup",
    "dev": "tsx index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "rm -rf dist && tsup"
  },
  "dependencies": {
    "@smithy/hash-node": "4.5.2",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.3",
    "gpt-tokenizer": "4.0.0",
    "ink": "7.1.1",
    "react": "19.2.8",
    "undici": "^8.10.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  }
}
